{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yarukoto",
  "version": "1.0.0",
  "identifier": "com.wyne.yarukoto",
  "build": {
    "frontendDist": "../client/dist-windows",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": {
      "script": "npx expo start --web --port 8081",
      "cwd": "../client",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run export:windows",
      "cwd": "../client"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Yarukoto",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Yarukoto",
    "shortDescription": "Yarukoto",
    "longDescription": "A self-hosted task manager.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
