{
  "name": "yarukoto-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "YARUKOTO_TOKEN=test node --import tsx --test test/*.test.ts",
    "pretest:coverage": "npm run build",
    "test:coverage": "YARUKOTO_TOKEN=test c8 --all --include='src/**/*.ts' --exclude='src/index.ts' --reporter=text --reporter=json-summary node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@yarukoto/domain": "*",
    "better-sqlite3": "^11.9.1",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "c8": "^12.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
