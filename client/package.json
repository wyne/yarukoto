{
  "name": "yarukoto-client",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/ui": "~57.0.9",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-camera": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-font": "^57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.16",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-renderer": "^4.1.1",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-sortables": "^1.10.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "57.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "start:tailscale": "scripts/start-tailscale.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development npx expo prebuild --clean && APP_VARIANT=development expo run:ios",
    "install:ipa": "scripts/install-ipa.sh",
    "mac": "scripts/build-mac.sh",
    "mac:dev": "scripts/mac-dev.sh",
    "mac:release": "scripts/release-mac.sh",
    "test": "TZ=America/New_York jest --runInBand --no-watchman",
    "test:coverage": "TZ=America/New_York jest --runInBand --no-watchman --coverage --coverageReporters=text --coverageReporters=json-summary",
    "test:e2e": "npm run build --prefix ../server && expo export --platform web --output-dir dist-e2e && playwright test",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "export:windows": "expo export --platform web --output-dir dist-windows"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "App.tsx",
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "testPathIgnorePatterns": ["/node_modules/", "/e2e/"]
  },
  "private": true
}
